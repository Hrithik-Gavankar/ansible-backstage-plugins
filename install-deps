#!/bin/bash

# This branch uses workspaces (workspaces/{aap,apme,portal-core,self-service}/plugins/*).
# Root yarn install resolves all workspace dependencies automatically.

printf "==================== Step: Root Deps Installation => Start ====================\n"
yarn install
printf "==================== Step: Root Deps Installation => Complete ====================\n"

printf "==================== Step: pre-commit CLI => Start ====================\n"
if command -v python3 >/dev/null 2>&1; then
  python3 -m pip install pre-commit || true

  if command -v pre-commit >/dev/null 2>&1; then
    pre-commit install-hooks
  elif python3 -m pre_commit install-hooks 2>/dev/null; then
    :
  else
    echo "Error: pre-commit is not available on PATH after install." >&2
    echo "Install manually: pip install pre-commit" >&2
    exit 1
  fi
else
  echo "Error: python3 not found. pre-commit is required for Git hooks." >&2
  echo "Install Python 3 and then: pip install pre-commit" >&2
  exit 1
fi
printf "==================== Step: pre-commit CLI => Complete ====================\n"

printf "==================== Step: yarn tsc => Start ====================\n"
if ! yarn tsc; then
  echo "==================== Step: yarn tsc => Failed ===================="
  popd > /dev/null || exit
  exit 1
fi
echo "==================== Step: yarn tsc => Complete ===================="
